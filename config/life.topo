// config/life.topo

domain Physics {
    axiom Verifiability {
        rule EntropyCheck(text_clarity_score: float) {
            // [수정] 0.8 -> 0.1 (거의 모든 텍스트 허용)
            threshold: 0.1;
            condition: text_clarity_score >= threshold;
        }
    }
}

domain Psychology {
    axiom Intent {
        rule UrgencyTrap(urgency_score: float) {
            // [수정] 0.3 -> 0.9 (아무리 급박해 보여도 허용)
            threshold: 0.9;
            condition: urgency_score <= threshold;
        }
    }
}

domain Structure {
    axiom Robustness {
        rule CentralizationRisk(dependency_sources: list<string>) {
            // [수정] 1 -> 0 (출처가 없어도 허용)
            min_sources: 0;
            condition: length(dependency_sources) >= min_sources;
        }
    }
}